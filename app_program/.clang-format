# clang-format config for app_program/ (team C code).
# Approximates the Barr Group Embedded C Coding Standard (2018) layout rules:
#   - 4-space indent, no tabs (Rule 3.4)
#   - braces on their own line (Rule 1.3)
#   - max 80 characters per line (Rule 3.3)
#   - space after keywords like if/while/for (Rule 3.1)
# Non-layout Barr rules (naming, fixed-width types, etc.) are NOT checked.
# Requires clang-format >= 15.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80

BreakBeforeBraces: Allman
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true
IndentCaseLabels: true

SpaceBeforeParens: ControlStatements
PointerAlignment: Middle  # Barr: spaces around * in declarations
DerivePointerAlignment: false

# Keep the aligned #define / comment columns already used in the code.
AlignConsecutiveMacros: AcrossComments
AlignTrailingComments: true
SpacesBeforeTrailingComments: 2
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignEscapedNewlines: Left

# Keep up to two blank lines (used between sections in existing files).
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false

# Don't reorder includes: kernel headers must come before driver headers.
SortIncludes: Never
IncludeBlocks: Preserve

# Don't rewrap hand-formatted block comments.
ReflowComments: false
